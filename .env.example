# Supabase (Auth). Copy to .env locally; set the same vars in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dev / preview only: skip magic-link auth (mock user). Exact value must be the string "true". Remove for real production.
# VITE_AUTH_BYPASS=true
#
# Without redeploying: on localhost or *.vercel.app, after a rate-limit error the login screen offers
# "מצב בדיקה", or in the console: localStorage.setItem('loby:emergency_auth_bypass','1'); location.reload()
