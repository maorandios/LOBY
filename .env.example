# Supabase (Auth). Copy to .env locally; set the same vars in Vercel → Project → Settings → Environment Variables.
# Optional: public HTTPS origin for Open Graph / canonical URLs (use your real domain, e.g. https://loby.co.il).
# Required for correct previews when sharing a custom domain (VERCEL_URL alone may still work for *.vercel.app).
# VITE_SITE_ORIGIN=https://your-app.vercel.app
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push: run `npm run generate:push-secrets` locally, then set in Vercel (never commit real values).
# VITE_VAPID_PUBLIC_KEY=

# Onboarding DB: run supabase/migrations/20260427120000_onboarding.sql in the Supabase SQL editor (once per project).
# Account delete uses Edge Function `delete-account`; deploy after pull: `supabase functions deploy delete-account` (verify_jwt on).
